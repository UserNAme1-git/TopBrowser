@page
@model IndexModel
@{
    ViewData["Title"] = "TopBrowser";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        /* ===== Общие стили (ПК) ===== */
        body {
            margin: 0;
            font-family: 'Segoe UI', Roboto, Arial, sans-serif;
            background: linear-gradient(135deg, #f9fbff, #e8f2ff);
            color: #1a1a1a;
            overflow-x: hidden;
        }

        h1, h2, h3 {
            margin: 0;
            font-weight: 600;
        }

        p {
            margin: 0 0 20px;
            line-height: 1.6;
        }

        a {
            color: #0066ff;
            text-decoration: none;
            transition: 0.3s;
        }

            a:hover {
                text-decoration: underline;
            }

        /* ===== Header ===== */
        header {
            background: linear-gradient(135deg, #007bff, #00b0ff);
            color: white;
            text-align: center;
            padding: 100px 60px;
            border-bottom-left-radius: 50px;
            border-bottom-right-radius: 50px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }

            header h1 {
                font-size: 56px;
                letter-spacing: 1px;
                margin-bottom: 20px;
            }

            header p {
                font-size: 20px;
                opacity: 0.95;
                max-width: 900px;
                margin: 0 auto;
            }

        /* ===== Секция "Почему именно мы" ===== */
        .features {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
            padding: 80px 60px;
            background: white;
        }

        .feature {
            background: #f8faff;
            border-radius: 20px;
            padding: 30px;
            width: 300px;
            text-align: center;
            box-shadow: 0 8px 16px rgba(0, 123, 255, 0.08);
            transition: all 0.3s ease;
        }

            .feature:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 20px rgba(0, 123, 255, 0.12);
            }

            .feature h3 {
                color: #007bff;
                margin-bottom: 10px;
                font-size: 22px;
            }

            .feature p {
                color: #444;
                font-size: 15px;
            }

        /* ===== Секция "Преимущества" ===== */
        .advantages {
            padding: 80px 60px;
            text-align: center;
            background: linear-gradient(180deg, #f4f9ff, #e9f3ff);
        }

            .advantages h2 {
                font-size: 36px;
                color: #007bff;
                margin-bottom: 50px;
            }

        .adv-list {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
        }

        .adv-item {
            background: white;
            border-radius: 16px;
            padding: 25px;
            width: 350px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .adv-item:hover {
                transform: translateY(-6px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            }

            .adv-item h3 {
                margin-bottom: 10px;
                color: #0056b3;
            }

            .adv-item p {
                color: #555;
                font-size: 15px;
            }

        /* ===== Footer ===== */
        footer {
            background: linear-gradient(135deg, #007bff, #00b0ff);
            color: white;
            text-align: center;
            padding: 25px;
            font-size: 14px;
            letter-spacing: 0.5px;
            box-shadow: 0 -3px 12px rgba(0,0,0,0.1);
            margin-top: 50px;
        }

    </style>
</head>
<body>

    <!-- ===== Header ===== -->
    <header>
        <h1>TopBrowser</h1>
        <p>Быстрый, безопасный и удобный браузер нового поколения. Работайте и отдыхайте с комфортом.</p>
    </header>

    <!-- ===== Почему именно мы ===== -->
    <section class="features">
        <div class="feature">
            <h3>🚀 Скорость</h3>
            <p>Мгновенная загрузка страниц и оптимизация под любые устройства.</p>
        </div>
        <div class="feature">
            <h3>🛡 Безопасность</h3>
            <p>Защита от вирусов, фишинга и утечек данных в реальном времени.</p>
        </div>
        <div class="feature">
            <h3>✨ Простота</h3>
            <p>Интуитивный интерфейс, понятный каждому пользователю.</p>
        </div>
        <div class="feature">
            <h3>⚙️ Настройка</h3>
            <p>Темы, расширения и гибкие параметры под твои нужды.</p>
        </div>
    </section>

    <!-- ===== Преимущества ===== -->
    <section class="advantages">
        <h2>Преимущества TopBrowser для ПК</h2>
        <div class="adv-list">
            <div class="adv-item">
                <h3>Лёгкий</h3>
                <p>Минимальное потребление ресурсов и высокая производительность.</p>
            </div>
            <div class="adv-item">
                <h3>Многофункциональный</h3>
                <p>Встроенные инструменты для комфортной работы.</p>
            </div>
            <div class="adv-item">
                <h3>Оптимизация</h3>
                <p>Максимальная стабильность и отзывчивость на Windows.</p>
            </div>
            <div class="adv-item">
                <h3>Обновления</h3>
                <p>Регулярные улучшения безопасности и добавление новых функций.</p>
            </div>
        </div>
    </section>

    <!-- ===== Footer ===== -->
    <footer>
        © 2025 TopBrowser — Быстрее. Умнее. Безопаснее.
    </footer>

</body>
</html>